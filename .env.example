# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional initial administrator provisioning. Set both values only in the
# deployment environment; never commit the real password.
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="replace-with-a-long-random-password"
ADMIN_NAME="Administrator"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neon/Vercel Postgres connection string. Required in Vercel for persistent
# authentication, registration, sessions, logout, password reset, and roles.
# The legacy productivity tables still use local SQLite and need a separate
# migration before those records can be considered durable on Vercel.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
